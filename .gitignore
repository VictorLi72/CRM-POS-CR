# Bases de datos locales (contienen datos de ventas/clientes reales del super)
*.db
*.db-wal
*.db-shm

# Dependencias (cada paquete ya tiene su propio .gitignore, esto es respaldo)
node_modules/

# Builds
dist/
release/

# Frontend compilado dentro del backend (generado por mvn package)
backend/src/main/resources/static/

# Node descargado por frontend-maven-plugin
backend/.node/

# Variables de entorno con secretos
.env

# Archivos del sistema operativo
.DS_Store
Thumbs.db
