{
  "name": "crm-super-frontend",
  "version": "1.0.1",
  "private": true,
  "description": "App de caja (POS/CRM) para supermercado - Electron + React",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:vite\" \"npm:electron:dev\"",
    "vite": "vite",
    "electron:dev": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.6",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "cr.super.crm",
    "productName": "CRM Super",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
